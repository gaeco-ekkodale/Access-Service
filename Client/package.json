{
  "name": "access",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode devlocal",
    "build:production": "tsc && vite build --mode production",
    "build:test": "tsc && vite build --mode test",
    "build:development": "tsc -b && vite build --mode development",
    "build:devlocal": "tsc -b && vite build --mode devlocal",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate-client-local": "openapi --input http://localhost:5131/swagger/v1/swagger.json --output src/api/AccessService --client fetch",
    "generate-usecase-client": "openapi --input http://localhost:5130/swagger/v1/swagger.json --output src/api/UseCaseService --client fetch"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.85.5",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.30.1",
    "react-window": "^1.8.10",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.9.0",
    "openapi-typescript-codegen": "^0.29.0",
    "postcss": "^8.4.47",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.79.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.1.3"
  }
}
