# =============================================================================
# AccessService - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
#
# Keycloak: server and client of this module share one realm client
# (KEYCLOAK_CLIENT_ID). The frontend reads its own roles from
# resource_access.<KEYCLOAK_CLIENT_ID>, so logging in through a different client
# would NOT carry them.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
# =============================================================================

# =============================================================================
# IMAGE TAGS
# =============================================================================
ACCESS_SERVER_TAG=latest
ACCESS_CLIENT_TAG=latest

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
IMAGE_BASE_PATH=crgaeco001.azurecr.io

# =============================================================================
# ASPIRE DASHBOARD (Monitoring)
# =============================================================================
OTLP_ENDPOINT=http://gaeco-monitor-aspire:18889

# =============================================================================
# KAFKA (Message Broker)
# =============================================================================
KAFKA_ADDRESS=gaeco-broker:29092

# --- Kafka Consumer Settings
KAFKA_CONSUMER_GROUP_ACCESS=accessrights-service-group
KAFKA_AUTO_OFFSET_RESET=Earliest
KAFKA_SESSION_TIMEOUT_MS=150000
KAFKA_MAX_POLL_INTERVAL_MS=1500000

# --- Kafka Topics
KAFKA_TOPICS_ACCESSRIGHTS=ekkodale.gaeco.access.public.accessrights
KAFKA_TOPICS_USERGROUPS=ekkodale.gaeco.access.public.userGroups
KAFKA_TOPICS_GUIDELINES=ekkodale.gaeco.guideline.public.uploaded
KAFKA_TOPICS_USECASEGUIDELINES=ekkodale.gaeco.access.public.usecaseGuidelines

# =============================================================================
# MINIO (Object Storage)
# =============================================================================
MINIO_ADDRESS=gaeco-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Minio Buckets & Files
MINIO_USECASEGUIDELINE_BUCKET=usecaseguideline

# =============================================================================
# KEYCLOAK (Authentication)
# =============================================================================
KEYCLOAK_SERVER_HOSTNAME=localhost:9345
KEYCLOAK_REALM=gaeco

# One client for both server and client of this module. The frontend reads its
# client roles from resource_access.<KEYCLOAK_CLIENT_ID>, the backend uses the
# secret for its service account.
KEYCLOAK_CLIENT_ID=app-access
KEYCLOAK_CLIENT_SECRET=xA2rd7bsPMZVGZhRo9CZhZ0KaUuLh5Ux

# =============================================================================
# EXTERNAL SERVICE HOSTNAMES
# =============================================================================
GUIDELINE_SERVER_HOSTNAME=localhost:5008
USECASE_SERVER_HOSTNAME=localhost:5130

# =============================================================================
# ACCESS SERVICE
# =============================================================================
# --- Access Service Postgres
ACCESS_POSTGRES_USER=accessservice
ACCESS_POSTGRES_PASSWORD=access-local-pw
ACCESS_POSTGRES_DATABASE=accessdb

# --- Access Service Server
ACCESS_SERVER_HOSTNAME=localhost:5131

# --- Access Service Client
ADMIN_ROLE_NAME=admin
MOUNT_ROUTE=/access

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Die folgenden Variablen werden in deployed Umgebungen vom Orchestrator
# injiziert und sind ausschliesslich fuer den lokalen Docker-Compose-Betrieb
# benoetigt.
# =============================================================================
STACK_NAME=access
ENVIRONMENT_NETWORK=gaeco-local
TRAEFIK_NETWORK=traefik-proxy
VOLUME_BASE_PATH=./volumes

# --- Override (Port-Bindings)
ACCESS_POSTGRES_OUTERPORT=5433
ACCESS_SERVER_OUTERPORT=5131
ACCESS_CLIENT_OUTERPORT=3132
